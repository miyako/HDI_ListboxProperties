<?xml version="1.0" encoding="UTF-8"?><preferences stamp="7">
	<com.4d>
		<deployment>
			<options/>
		</deployment>
		<general startup_environnement="1"/>
		<interface>
			<user flush_window="false" print_progress="false" splash_screen="false"/>
		</interface>
		<compiler>
			<options fat_binary="true" compilation_path="1"/>
			<typage default_for_button="2" default_for_numeric="1"/>
		</compiler>
		<database>
			<cache adaptative="false" flush_buffer_delay="20s"/>
			<misc standard_xpath="false" non_blocking_printing="false"/>
		</database>
		<server>
			<network>
				<options publication_name="ListboxProperties"/>
				<client_server use_encryption="false"/>
			</network>
		</server>
		<web>
			<standalone_server>
				<configuration port_number="80" session_mode="3" automatic_session_management="true"/>
			</standalone_server>
			<remote>
				<configuration session_mode="3" automatic_session_management="true"/>
			</remote>
		</web>
		<sql>
			<publication allow_flash_player_requests="false" port_number="19812"/>
		</sql>
		<php ip_address="127.0.0.1"/>
	</com.4d>
</preferences>